{
  "expo": {
    "name": "Seam",
    "slug": "scrl-d",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seam",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.gauransh.seam",
      "supportsTablet": false,
      "appleTeamId": "4G6ND24TW6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gauransh.seam"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seam uses your photos to build your carousel."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Seam saves your finished slides to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-local-notifications-only"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0A",
    "extra": {
      "templatesUrl": ""
    }
  }
}
